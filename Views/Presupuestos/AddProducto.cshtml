@model PresupuestoDetalle

<h2>Agregar Producto</h2>

<form asp-action="AddProducto" method="post">
    <input type="hidden" name="idPresupuesto" value="@ViewBag.IdPresupuesto" />

    <div class="mb-3">
        <label>Producto</label>
        <select name="idProducto" class="form-select">
            @foreach(var p in ViewBag.Productos)
            {
                <option value="@p.IdProducto">@p.Descripcion - $@p.Precio</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Cantidad</label>
        <input name="cantidad" class="form-control" value="1" />
    </div>

    <button class="btn btn-primary">Agregar</button>
</form>
