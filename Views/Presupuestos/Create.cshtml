@model Presupuesto

<h2>Crear Presupuesto</h2>

<form method="post" asp-action="Create">
    <div class="form-group">
        <label>Nombre Destinatario</label>
        <input class="form-control" asp-for="NombreDestinatario" required />
    </div>

    <div class="form-group">
        <label>Fecha</label>
        <input class="form-control" asp-for="FechaCreacion" type="date" required />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a class="btn btn-secondary" href="/Presupuestos">Cancelar</a>
</form>
